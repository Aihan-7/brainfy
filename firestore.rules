// ────────────────────────────────────────────────────────────────────────────
//  Firestore security rules for Brainfy
//
//  Goal: each signed-in user can read/write only their own
//  users/{uid} document. Nobody else can list, read, or write them.
//
//  TO APPLY:
//    1. Firebase Console → Firestore Database → Rules
//    2. Paste this file's contents in
//    3. Click "Publish"
//
//  Without these rules, the default (test-mode or restrictive) rules will
//  reject the client-side reads/writes and the sync chip will show
//  "Sync failed — tap to retry" forever.
// ────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read + write only the document keyed by their own uid.
    match /users/{userId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;

      // The app writes this document through a transaction that raises `rev`
      // with every write, so a tab left open can't overwrite newer data from
      // another device (AUDIT-2026-10-17.md, P0-3). Once a document carries
      // `rev`, an update must raise it — which also stops a tab still running
      // an app version from before revisions (it writes no `rev`) from
      // overwriting newer data. A document without `rev` yet stays writable as
      // before, so these rules can be published before or after the app update.
      allow update: if request.auth != null && request.auth.uid == userId
        && (!('rev' in resource.data)
            || (request.resource.data.get('rev', 0) is number
                && request.resource.data.get('rev', 0) > resource.data.rev));

      // (Future) subcollections under users/{uid}/... At least one segment
      // below users/{uid}: in rules_version 2 a bare {document=**} here also
      // matches users/{uid} itself, and its `allow write` would let any update
      // through, `rev` or not.
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community-shared decks. World-READABLE (that's the point of sharing), but
    // a user may only create/modify/delete decks they own. Validated on write
    // to prevent impersonation and cap size (anti-abuse). Card text is HTML-
    // escaped on render client-side, so public content can't inject markup.
    match /publicDecks/{deckId} {
      allow read: if true;

      allow create: if request.auth != null
        // The client picks this document id, and it ends up in rendered HTML and
        // in /decks/<id> URLs. Firestore itself permits quotes, parens and
        // semicolons in ids, so constrain it here to the same character set
        // functions/decks/[id].js will accept. Defence in depth for the client
        // render path (see AUDIT-2026-08-16.md, P0-1).
        && deckId.matches('^[A-Za-z0-9_-]{1,64}$')
        // `approved` is a moderation field owned by us, not by the publisher.
        // Absent = visible (publishing stays instant); approved:false, set from
        // the console, pulls the deck from /decks, the sitemap and its own page.
        && !request.resource.data.keys().hasAny(['approved'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        // The colour lands in other users' style="" attributes, where escaping
        // does not help: strict #rrggbb only (AUDIT-2026-10-17.md, P0-2).
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        // Bound the other free-text fields that land on other users' screens and
        // in the /decks pages. The app trims them to 60 / 300 characters; these
        // limits are looser so a legitimate publish is never refused, however
        // size() counts non-Latin text.
        && request.resource.data.get('ownerName', '') is string
        && request.resource.data.get('ownerName', '').size() <= 200
        && request.resource.data.get('desc', '') is string
        && request.resource.data.get('desc', '').size() <= 1000
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 1000;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        // An owner may edit their deck but never flip their own moderation flag.
        && request.resource.data.get('approved', true) == resource.data.get('approved', true)
        // Name was validated on create but not here, so a published deck could be
        // renamed to an unbounded string that became the page <title>.
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.get('ownerName', '') is string
        && request.resource.data.get('ownerName', '').size() <= 200
        && request.resource.data.get('desc', '') is string
        && request.resource.data.get('desc', '').size() <= 1000
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 1000;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Everything else: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
