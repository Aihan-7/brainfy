// ────────────────────────────────────────────────────────────────────────────
//  Firestore security rules for Brainfy
//
//  Goal: each signed-in user can read/write only their own
//  users/{uid} document. Nobody else can list, read, or write them.
//
//  TO APPLY:
//    1. Firebase Console → Firestore Database → Rules
//    2. Paste this file's contents in
//    3. Click "Publish"
//
//  Without these rules, the default (test-mode or restrictive) rules will
//  reject the client-side reads/writes and the sync chip will show
//  "Sync failed — tap to retry" forever.
// ────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read + write only the document keyed by their own uid.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // (Future) subcollections under users/{uid}/...
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community-shared decks. World-READABLE (that's the point of sharing), but
    // a user may only create/modify/delete decks they own. Validated on write
    // to prevent impersonation and cap size (anti-abuse). Card text is HTML-
    // escaped on render client-side, so public content can't inject markup.
    match /publicDecks/{deckId} {
      allow read: if true;

      allow create: if request.auth != null
        // The client picks this document id, and it ends up in rendered HTML and
        // in /decks/<id> URLs. Firestore itself permits quotes, parens and
        // semicolons in ids, so constrain it here to the same character set
        // functions/decks/[id].js will accept. Defence in depth for the client
        // render path (see AUDIT-2026-08-16.md, P0-1).
        && deckId.matches('^[A-Za-z0-9_-]{1,64}$')
        // `approved` is a moderation field owned by us, not by the publisher.
        // Absent = visible (publishing stays instant); approved:false, set from
        // the console, pulls the deck from /decks, the sitemap and its own page.
        && !request.resource.data.keys().hasAny(['approved'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 1000;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        // An owner may edit their deck but never flip their own moderation flag.
        && request.resource.data.get('approved', true) == resource.data.get('approved', true)
        // Name was validated on create but not here, so a published deck could be
        // renamed to an unbounded string that became the page <title>.
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.cards is list
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 1000;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Everything else: deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
